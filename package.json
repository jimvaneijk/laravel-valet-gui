{
  "name": "laravel-valet-gui",
  "version": "0.1.0",
  "description": "Desktop GUI for Laravel Valet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --publish never",
    "release": "electron-builder --mac --publish always"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller": false
  },
  "author": "Jim van Eijk",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "productName": "Valet GUI",
  "repository": "github:jimvaneijk/laravel-valet-gui",
  "license": "MIT",
  "build": {
    "appId": "nl.jimvaneijk.valet-gui",
    "productName": "Valet GUI",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "jimvaneijk",
      "repo": "laravel-valet-gui",
      "releaseType": "release"
    }
  }
}
